# Backend (Python)
# ──────────────────────────────────────

# Large model files
*.dat
*.pickle

# Face datasets (stored in Firebase)
backend/face_dataset/

# Attendance data (generated at runtime)
backend/data/

# Python cache
__pycache__/
*.pyc

# Captured faces (runtime)
backend/captured_faces/

# API testing data (contains PII)
backend/api_testing/

# Logs
*.log

# ──────────────────────────────────────
# Secrets & Environment
# ──────────────────────────────────────
facial-attendance-binus-firebase-adminsdk.json
.env
.env.local
# Local device password overrides (Hikvision)
backend/devices.local.json
# Monitoring stack secrets
monitoring/.env
monitoring/.env.local

# ──────────────────────────────────────
# Frontend / Vite / Node
# ──────────────────────────────────────
.vite/
node_modules/

# ──────────────────────────────────────
# Misc
