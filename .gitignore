*.json.bak
DOCS.md
.DS_Store
mobile-attendance/src/components/settings.json

# Local virtual envs and editor configs
.venv/
.vscode/
backend/devices.local.json.bak.*

# Commit message scratch file (PS 5.1 multi-line workaround)
.git-commit-msg.tmp
